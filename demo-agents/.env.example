# Copy this file to .env (in this folder) and fill it in. Never share .env: it holds the agents' keys.

# The Control Tower site the agents talk to (the client demo site, or the work-in-progress site for rehearsals).
ACT_URL=https://agent-control-tower-56p.pages.dev

# Each agent's own key, made on its page in the Control Tower (Agents → open the agent → API keys → New key).
# Keys are shown once. A demo data reset deletes every key, so make new ones after each reset.
PAYMENT_AGENT_KEY=
SCREENING_AGENT_KEY=

# The agents' codes. These are the demo data's codes; change them only if yours differ.
PAYMENT_AGENT=AGT-0001
SCREENING_AGENT=AGT-0003
